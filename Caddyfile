portainer.lab {
    tls internal
    log
    # Generate your own hash: docker run --rm caddy:2.9.1 caddy hash-password --plaintext '<your-password>'
    # IMPORTANT: do not wrap the hash in single quotes — Caddyfile doesn't
    # treat ' as a string delimiter, so it becomes a literal character
    # prepended to the hash and crash-loops the container with
    # "illegal base64 data at input byte 0". No quotes needed at all,
    # since the hash contains no spaces.
    basic_auth {
        <ADMIN_USER> <BCRYPT_HASH>
    }
    reverse_proxy portainer:9443 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}

