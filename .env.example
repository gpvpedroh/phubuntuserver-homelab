# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Navidrome ---
NAVIDROME_ADMIN_PW=

# --- CalibreWeb ---
CALIBREWEB_PW=

# --- Immich / Postgres ---
IMMICH_DB_USERNAME=
IMMICH_DB_PASSWORD=
IMMICH_DB_DATABASE_NAME=

# --- Vaultwarden ---
# Generate via: docker exec -it vaultwarden ./vaultwarden hash
# Store the resulting Argon2id hash here, not a plaintext password.
VAULTWARDEN_ADMIN_TOKEN=

# --- Beszel agent ---
# Generate fresh in the Beszel Hub UI (Add System) — do not reuse an
# old TOKEN/KEY pair if this repo or its history was ever exposed.
BESZEL_AGENT_TOKEN=
BESZEL_AGENT_KEY=
